<?xml version="1.0" encoding="utf-8"?>
<!-- Manifest برنامه: Permission، نام، آیکون، Theme و Activity ورودی را مشخص می‌کند. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- اینترنت فقط برای Update Checker و باز کردن لینک نسخه جدید لازم است. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@drawable/ic_app_icon"
        android:label="دستیار هوشمند کابینتسازی"
        android:roundIcon="@drawable/ic_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MDFchi">
        <!-- MainActivity ورودی اصلی برنامه است. -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
